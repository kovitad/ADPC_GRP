# Local API and static web UI
GRP_ENV=dev
GRP_PUBLIC_BASE_URL=http://127.0.0.1:8000
STORAGE_ROOT=.local/data
DATABASE_URL_FILE=.local/secrets/database_url

# Existing-SIG-account sign-in (public PKCE client; no client secret required)
HUMAN_IDENTITY_PROVIDER=servir_sig
AUTH_CALLBACK_PATH=/api/v1/auth/callback
SIG_MCP_BASE_URL=https://servirplatform.sig-gis.com/mcp
SERVIR_AUTH_ISSUER=
SERVIR_AUTH_CLIENT_ID=
SERVIR_AUTH_CLIENT_SECRET_FILE=.local/secrets/servir_auth_client_secret
SERVIR_AUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/callback

# Local session
SESSION_SECRET_FILE=.local/secrets/session_secret
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12

# Future LLM integration (disabled until the AI slice is implemented and accepted)
AI_FEATURE_ENABLED=false
AI_PROVIDER=
AI_MODEL=
AI_BASE_URL=
# Put the raw token in this ignored file, never in .env.
AI_KEY_FILE_ADPC=.local/secrets/ai_key_adpc
AI_MAX_OUTPUT_TOKENS=800
AI_TIMEZONE=Asia/Bangkok
