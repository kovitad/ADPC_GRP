        <mxCell id="stack" value="Current and recommended technology" style="swimlane;horizontal=1;startSize=38;rounded=1;collapsible=0;whiteSpace=wrap;html=1;fillColor=#F7FBFE;strokeColor=#1769AA;fontColor=#172B34;fontSize=16;align=center;verticalAlign=middle;spacing=8;fontStyle=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="750" width="900" height="430" as="geometry" />
        </mxCell>
        <mxCell id="done" value="Definition of done / non-negotiable controls" style="swimlane;horizontal=1;startSize=38;rounded=1;collapsible=0;whiteSpace=wrap;html=1;fillColor=#FFFCF4;strokeColor=#C48A00;fontColor=#172B34;fontSize=16;align=center;verticalAlign=middle;spacing=8;fontStyle=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1060" y="750" width="960" height="430" as="geometry" />
        </mxCell>
        <mxCell id="stack1" value="&lt;b&gt;Web&lt;/b&gt;&lt;br&gt;Static HTML/CSS/JS + Leaflet&lt;br&gt;split planning.js into area/config/package/map modules&lt;br&gt;SSE with polling fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEAF7;strokeColor=#1769AA;fontColor=#172B34;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontStyle=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="130" y="840" width="360" height="260" as="geometry" />
        </mxCell>
        <mxCell id="stack2" value="&lt;b&gt;Backend&lt;/b&gt;&lt;br&gt;Python 3.12 • FastAPI • Pydantic • SQLAlchemy&lt;br&gt;PostgreSQL 16 + PostGIS • Alembic&lt;br&gt;rasterio • pyogrio • shapely&lt;br&gt;Docker Compose • Caddy • managed storage protocol" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F2E8;strokeColor=#4E8A57;fontColor=#172B34;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontStyle=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="540" y="840" width="390" height="260" as="geometry" />
        </mxCell>
        <mxCell id="done1" value="&lt;b&gt;Every number&lt;/b&gt;&lt;br&gt;Evidence key • source/version • scope • unit • denominator&lt;br&gt;&lt;br&gt;&lt;b&gt;Every job&lt;/b&gt;&lt;br&gt;Idempotency • lease/fence • trace • typed failure&lt;br&gt;&lt;br&gt;&lt;b&gt;Every route&lt;/b&gt;&lt;br&gt;x-grp-access • CSRF where mutating • fail-closed Hub scope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#C48A00;fontColor=#172B34;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontStyle=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1110" y="830" width="410" height="300" as="geometry" />
        </mxCell>
        <mxCell id="done2" value="&lt;b&gt;Never&lt;/b&gt;&lt;br&gt;LLM SQL/filesystem access&lt;br&gt;arbitrary MCP calls&lt;br&gt;preview PNG as assessment input&lt;br&gt;NoData interpreted without DEP-05&lt;br&gt;candidate called safe&lt;br&gt;invented capacity/population/cost/ROI&lt;br&gt;private Hub evidence sent to SIG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE5E5;strokeColor=#B33A3A;fontColor=#172B34;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontStyle=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1570" y="830" width="400" height="300" as="geometry" />
        </mxCell>
