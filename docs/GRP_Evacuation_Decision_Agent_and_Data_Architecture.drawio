  <diagram name="5 Implementation and technology" id="5-implementation-and-technology">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Implementation roadmap and technology stack&lt;/b&gt;&lt;br&gt;&lt;font color='#60727B'&gt;Deliver decision value incrementally without fabricating unavailable science or splitting into premature microservices&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#172B34;fontSize=24;align=center;verticalAlign=middle;spacing=8;fontStyle=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1800" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a" value="&lt;b&gt;Phase A — contracts and honest UX&lt;/b&gt;&lt;br&gt;AOI API • evidence envelope • coverage matrix&lt;br&gt;input resolver • separate GRP/SIG sections" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEAF7;strokeColor=#1769AA;fontColor=#172B34;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontStyle=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="180" width="420" height="180" as="geometry" />
        </mxCell>
        <mxCell id="b" value="&lt;b&gt;Phase B — sub-district catalogue&lt;/b&gt;&lt;br&gt;7,436 polygons • parent links • qualified search&lt;br&gt;unsupported until explicitly activated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F2E8;strokeColor=#4E8A57;fontColor=#172B34;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontStyle=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="560" y="180" width="420" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c" value="&lt;b&gt;Phase C — durable package&lt;/b&gt;&lt;br&gt;package/revision/evidence/gap tables&lt;br&gt;leased worker • SSE • partial failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#C48A00;fontColor=#172B34;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontStyle=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1040" y="180" width="420" height="180" as="geometry" />
        </mxCell>
        <mxCell id="d" value="&lt;b&gt;Phase D — real movement screening&lt;/b&gt;&lt;br&gt;DEP-05 • pilot area approval • real locked result&lt;br&gt;candidate does not mean safe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE5E5;strokeColor=#B33A3A;fontColor=#172B34;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontStyle=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1520" y="180" width="420" height="180" as="geometry" />
        </mxCell>
        <mxCell id="e" value="&lt;b&gt;Phase E — vulnerability and suitability&lt;/b&gt;&lt;br&gt;approved population • capacity • accessibility&lt;br&gt;services and route methods" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0E8F7;strokeColor=#704A8E;fontColor=#172B34;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontStyle=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="560" y="480" width="420" height="180" as="geometry" />
        </mxCell>
        <mxCell id="f" value="&lt;b&gt;Phase F — investment and comparison&lt;/b&gt;&lt;br&gt;approved costs/interventions • multiple RPs&lt;br&gt;DEP-12 private brief and map exports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F2E8;strokeColor=#4E8A57;fontColor=#172B34;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontStyle=1;dashed=0;" vertex="1" parent="1">
