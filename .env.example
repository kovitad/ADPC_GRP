# Environment
GRP_ENV=staging
GRP_PUBLIC_BASE_URL=https://staging-risk-servir.adpc.net
STORAGE_ROOT=/srv/grp/data
GRP_IMAGE=grp-api:local

# Database
DATABASE_URL_FILE=/run/grp-secrets/database_url

# Existing-SIG-account sign-in; issuer is optional and otherwise discovered from SIG_MCP_BASE_URL.
HUMAN_IDENTITY_PROVIDER=servir_sig
AUTH_CALLBACK_PATH=/api/v1/auth/callback
SERVIR_AUTH_ISSUER=
SERVIR_AUTH_CLIENT_ID=
# Optional for a confidential client; omit the file for a public PKCE client.
SERVIR_AUTH_CLIENT_SECRET_FILE=/run/grp-secrets/servir_auth_client_secret
SERVIR_AUTH_REDIRECT_URI=https://staging-risk-servir.adpc.net/api/v1/auth/callback
SIG_MCP_BASE_URL=https://servirplatform.sig-gis.com/mcp

# GRP session
SESSION_SECRET_FILE=/run/grp-secrets/session_secret
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12

# SIG service-to-service integration
SIG_CLIENT_AUDIENCE=
SIG_ALLOWED_CLIENT_IDS=
SIG_SERVICE_TOKEN_HASH_FILE=/run/grp-secrets/sig_service_token_hash

# Background assessment worker
WORKER_CONCURRENCY=1
JOB_LEASE_MINUTES=15

# AI gateway
AI_FEATURE_ENABLED=false
AI_PROVIDER=
AI_MODEL=
AI_BASE_URL=
# Put the token in this root-owned file, not directly in .env.
AI_KEY_FILE_ADPC=/run/grp-secrets/ai_key_adpc
AI_MAX_OUTPUT_TOKENS=800
AI_TIMEZONE=Asia/Bangkok

# AI quality monitoring
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY_FILE=/run/grp-secrets/langfuse_secret_key

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=

# Rate limits
RATE_LIMITS='{"api_requests_per_person_per_minute":60,"new_assessments_per_person_per_hour":10,"sig_evidence_reads_per_minute":30,"ai_requests_per_person_per_hour":20}'
